import { Theme } from "theme.slint";

export component LoadingSpinner inherits Rectangle {
    in property <image> frame;
    in property <string> message: "Loading...";
    in property <string> sub-message: "";
    in property <length> spinner-size: 72px;

    background: transparent;
    width: 100%;
    height: 100%;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            Image {
                source: root.frame;
                width: root.spinner-size;
                height: root.spinner-size;
                image-fit: contain;
                image-rendering: pixelated;
            }
        }

        if root.message != "": Text {
            text: root.message;
            color: Theme.accent;
            font-family: Theme.font-family;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        if root.sub-message != "": Text {
            text: root.sub-message;
            color: Theme.text-secondary;
            font-family: Theme.font-family;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
}
