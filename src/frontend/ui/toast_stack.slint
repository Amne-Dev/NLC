import { Theme } from "theme.slint";
import { PixelCloseIcon } from "components.slint";

export struct ToastItemData {
    id: string,
    title: string,
    detail: string,
    progress: float,
    status: string,           // "normal", "completed", "error", "warning"
    timeout_fraction: float, // 1.0 down to 0.0
    is_sticky: bool,
    can_copy: bool,
    error_payload: string,
}

export component ToastCard inherits Rectangle {
    in property <ToastItemData> data;
    in property <bool> animations-enabled: true;
    callback dismiss(string);
    callback copy-error(string);
    callback mouse-enter(string);
    callback mouse-leave(string);

    width: 340px;
    min-height: 52px;
    background: root.data.status == "error" ? #221114 :
                root.data.status == "warning" ? #241A0A :
                root.data.status == "completed" ? #0E2016 : #16181E;
    border-width: 1px;
    border-color: root.data.status == "error" ? #5C1D24 :
                  root.data.status == "warning" ? #5E4014 :
                  root.data.status == "completed" ? #1B4D2E : #2D3340;
    clip: true;

    animate background { duration: root.animations-enabled ? 150ms : 0ms; }
    animate border-color { duration: root.animations-enabled ? 150ms : 0ms; }

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.mouse-enter(root.data.id);
            }
            if event.kind == PointerEventKind.cancel {
                root.mouse-leave(root.data.id);
            }
        }
    }

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 10px;
        padding-right: 8px;
        spacing: 0px;
        alignment: center;

        HorizontalLayout {
            spacing: 10px;
            alignment: center;

            // Status Indicator Icon Box
            Rectangle {
                width: 28px;
                height: 28px;
                background: root.data.status == "error" ? #C0392B :
                            root.data.status == "warning" ? #D35400 :
                            root.data.status == "completed" ? #27AE60 : #2C3444;

                Text {
                    text: root.data.status == "error" ? "X" :
                          root.data.status == "warning" ? "!" :
                          root.data.status == "completed" ? "✓" : "i";
                    font-family: Theme.font-family;
                    font-size: 13px;
                    font-weight: 700;
                    color: #FFFFFF;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Title & Detail (Content-adaptive height, word wrap)
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;

                Text {
                    text: root.data.title;
                    font-family: Theme.font-family;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    overflow: elide;
                }

                Text {
                    text: root.data.detail;
                    font-family: Theme.font-family;
                    font-size: 10px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            // Right side Action Pills: Copy Error + Dismiss
            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                if root.data.can-copy: Rectangle {
                    height: 22px;
                    width: 68px;
                    background: copy-touch.has-hover ? #78281F : #4A171D;
                    border-width: 1px;
                    border-color: #922B21;

                    copy-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.copy-error(root.data.error-payload != "" ? root.data.error-payload : root.data.detail);
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: "📋 Copy";
                            font-family: Theme.font-family;
                            font-size: 9px;
                            font-weight: 700;
                            color: #FFFFFF;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    width: 22px;
                    height: 22px;
                    background: close-touch.has-hover ? Theme.input-bg : transparent;

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dismiss(root.data.id); }
                    }

                    PixelCloseIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon-color: close-touch.has-hover ? #FFFFFF : Theme.text-secondary;
                    }
                }
            }
        }
    }

    // Dismiss Timeout Countdown Micro-bar (2px sharp track, 0px corners)
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: parent.width;
        background: #14171E;

        Rectangle {
            x: 0px;
            y: 0px;
            height: parent.height;
            width: parent.width * (root.data.is-sticky ? min(1.0, max(0.0, root.data.progress / 100.0)) : min(1.0, max(0.0, root.data.timeout-fraction)));
            background: root.data.status == "error" ? Theme.danger :
                        root.data.status == "warning" ? #E67E22 :
                        root.data.status == "completed" ? Theme.success : Theme.accent;
        }
    }
}

export component ToastContainer inherits Rectangle {
    in property <[ToastItemData]> toasts: [];
    in property <bool> animations-enabled: true;
    callback dismiss-toast(string);
    callback copy-error(string);
    callback pause-toast(string);
    callback resume-toast(string);

    width: 340px;
    background: transparent;
    clip: false;

    VerticalLayout {
        spacing: 6px;
        alignment: end; // Stacks from bottom up: older toasts move up

        for t in root.toasts: ToastCard {
            data: t;
            animations-enabled: root.animations-enabled;
            dismiss(id) => { root.dismiss-toast(id); }
            copy-error(err) => { root.copy-error(err); }
            mouse-enter(id) => { root.pause-toast(id); }
            mouse-leave(id) => { root.resume-toast(id); }
        }
    }
}

