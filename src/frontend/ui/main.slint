                            delete-skin-preset(id) => { root.delete-skin-preset(id); }

                            upload-skin => { root.upload-skin(); }

                            steal-skin => { root.steal-skin(); }

                            export-skin => { root.export-skin(); }

                            refresh-skin => { root.refresh-skin(); }

