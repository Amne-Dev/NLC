                        if root.current-tab == "Settings": SettingsScreen {
                            launcher-logo: root.launcher-logo;

                            width: parent.width;

                            height: parent.height;

                            current-category <=> root.current-settings-cat;

                            post-launch-action <=> root.post-launch-action;

                            close-on-launch <=> root.close-on-launch;

                            minimize-to-tray <=> root.minimize-to-tray;

                            keep-console-open <=> root.keep-console-open;

                            show-launch-logs <=> root.show-launch-logs;

                            smooth-animations <=> root.smooth-animations;

                            enable-walking-mobs <=> root.enable-walking-mobs;

                            selected-theme <=> root.selected-theme;

                            custom-hex <=> root.custom-hex;

                            share-resource-packs <=> root.share-resource-packs;

                            share-shader-packs <=> root.share-shader-packs;

                            share-worlds <=> root.share-worlds;

                            share-mod-configs <=> root.share-mod-configs;

                            total-system-ram-mb <=> root.total-system-ram-mb;

                            total-system-ram-str <=> root.total-system-ram-str;

                            ram-allocation-mb <=> root.ram-allocation-mb;

                            java-executable <=> root.java-executable;

                            jvm-arguments <=> root.jvm-arguments;

                            minecraft-directory <=> root.minecraft-directory;

                            max-modpack-downloads <=> root.max-modpack-downloads;

                            max-mod-downloads <=> root.max-mod-downloads;

                            throttle-downloads <=> root.throttle-downloads;

                            max-download-speed-kb <=> root.max-download-speed-kb;

                            check-updates-startup <=> root.check-updates-startup;

                            discord-rpc <=> root.discord-rpc;

                            discord-detail <=> root.discord-detail;

                            discord-connected <=> root.discord-connected;

                            discord-status <=> root.discord-status;

                            discord-show-timer <=> root.discord-show-timer;

                            discord-show-idle <=> root.discord-show-idle;

                            discord-show-server <=> root.discord-show-server;

                            discord-preview-mode <=> root.discord-preview-mode;

                            streamer-privacy <=> root.streamer-privacy;

                            default-offline-name <=> root.default-offline-name;

                            active-head-image <=> root.active-head-image;

                            has-active-head <=> root.has-active-head;

                            logs-text <=> root.logs-text;

                            setting-toggled(key, val) => { root.setting-changed(key, val); }

                            setting-int-changed(key, val) => { root.setting-int-changed(key, val); }

                            setting-string-changed(key, val) => { root.setting-string-changed(key, val); }

                            browse-java-path => { root.browse-java-path(); }

                            available-java-paths <=> root.available-java-paths;
                            auto-detect-java => { root.auto-detect-java(); }
                            deselect-java => { root.deselect-java(); }

                            change-minecraft-dir => { root.change-minecraft-dir(); }

                            replay-wizard => { root.replay-wizard(); }

                            open-folder(f) => { root.open-folder(f); }

                            open-github => { root.open-dock("github"); }

                            select-theme(theme) => {

                                root.selected-theme = theme;

                                root.select-theme(theme);

                            }

                            apply-custom-hex(hex) => {

                                root.custom-hex = hex;

                                root.apply-custom-hex(hex);

                            }

                            ram-preset-clicked(mb) => {

                                root.ram-allocation-mb = mb;

                                root.ram-preset-clicked(mb);

                            }

                            refresh-logs => { root.refresh-logs(); }

                            copy-logs => { root.copy-logs(); }

                            clear-cache => { root.clear-cache(); }

                            reset-defaults => { root.reset-defaults(); }

                            export-diagnostics => { root.export-diagnostics(); }

                            check-updates => { root.check-updates(); }

                        }



                        if root.current-tab == "Screenshots": ScreenshotsScreen {

                            width: parent.width;

                            height: parent.height;

                            screenshots <=> root.screenshots;

                            animations-enabled: root.smooth-animations;

                            open-folder => { root.open-folder("screenshots"); }

                            refresh => { root.refresh-screenshots(); }

                            delete-screenshot(id) => { root.delete-screenshot(id); }

                        }

                    }



                    // --- 80px Bottom Launch Bar (EXCLUSIVE TO PLAY HERO TAB, DOCKED WITHIN RIGHT PANE) ---

                    if root.current-tab == "Play": BottomBar {

                        instance-name <=> root.selected-instance;

                        version-id <=> root.selected-version;

                        version-display <=> root.selected-version-display;

                        installation-id <=> root.selected-installation-id;

                        loader <=> root.selected-loader;

                        instance-icon <=> root.selected-instance-icon;

                        profile-name <=> root.username;

                        is-launching <=> root.is-launching;

                        launch-progress: root.launch-progress;

                        launch-log-text: root.launch-log-text;

                        show-launch-logs: root.show-launch-logs;

                        installations <=> root.installations;



                        cancel-launch => {

                            root.cancel-launch();

                        }

                        play-clicked => {

                            root.is-launching = true;

                            root.launch-game(root.selected-installation-id, root.selected-version, root.selected-loader);

                        }

                        force-update-and-play => {

                            root.is-launching = true;

                            root.force-update-and-play-game(root.selected-installation-id, root.selected-version, root.selected-loader);

                        }

                        instance-selected(inst, ver, id, ldr) => {

                            root.selected-instance = inst;

                            root.selected-version = ver;

                            root.selected-installation-id = id;

                            root.selected-loader = ldr;

                            root.installation-selected(inst, id);

                        }

                        instance-picker-clicked => { }

                    }

                }



                // --- Floating Walking Mob Layer (runs across top of 80px bottom bar, clips behind sidebar) ---

                if root.current-tab == "Play" && root.walking-mob-visible: Image {

                    x: root.walking-mob-x;

                    y: parent.height - 80px - self.height + (root.walking-mob-is-flying ? -8px : 1px);

                    width: root.walking-mob-width;

                    height: root.walking-mob-height;

                    source: root.walking-mob-frame;

                    image-fit: contain;

                    image-rendering: pixelated;



                    animate x { duration: Theme.smooth-animations ? 60ms : 0ms; easing: linear; }

                }

            }

        }

    }



    // --- Slide-over Notification Drawer Overlay (320px wide, right-anchored) ---

    if root.notifications-open: NotificationDrawer {

        x: 0px;

        y: 0px;

        width: root.width;

        height: root.height;

        items <=> root.notifications;

        active-count: root.notifications.length;

        active-downloads: root.active-downloads-count;

        active-sessions: root.active-sessions-count;

        unread-count: root.unread-notifications;

        close => { root.notifications-open = false; }

        clear-all => { root.clear-notifications(); }

        dismiss-item(id) => { root.dismiss-notification(id); }

    }



    // --- Floating Stacked Notification Toasts (bottom-right anchored, max 4, slides above active-sessions or bottom-bar) ---

    property <bool> show-toasts: root.active-toasts.length > 0 && !root.notifications-open;

    property <length> base-bottom-clearance: root.current-tab == "Play" ? 92px : 16px;

    property <length> active-sessions-offset: root.show-active-sessions ? (active-sessions-widget.height + 10px) : 0px;

    property <length> toast-target-y: root.height - toast-stack-widget.height - root.base-bottom-clearance - root.active-sessions-offset;

    toast-stack-widget := ToastContainer {

        x: max(250px, root.width - self.width - 20px);

        y: root.show-toasts ? root.toast-target-y : (root.height + 60px);

        opacity: root.show-toasts ? 1.0 : 0.0;

        toasts <=> root.active-toasts;

        animations-enabled: root.smooth-animations;



        animate y { duration: root.smooth-animations ? 250ms : 0ms; easing: ease-out; }

        animate opacity { duration: root.smooth-animations ? 200ms : 0ms; }



        dismiss-toast(id) => {

            root.dismiss-toast(id);

        }

        copy-error(err) => {

            root.copy-toast-error(err);

        }

        pause-toast(id) => {

            root.pause-toast(id);

        }

        resume-toast(id) => {

            root.resume-toast(id);

        }

    }



    // --- Account Center Modal (Sharp 0px Modal Overlay) ---

    if root.add-account-modal-open: AddAccountModal {

        x: 0px;

        y: 0px;

        width: root.width;

        height: root.height;

        is-open <=> root.add-account-modal-open;

        mode <=> root.add-account-modal-mode;

        ms-user-code <=> root.ms-user-code;

        ms-verification-uri <=> root.ms-verification-uri;

        ms-status <=> root.ms-status;

        elyby-username <=> root.elyby-username;

        elyby-password <=> root.elyby-password;

        offline-username <=> root.offline-username;

        error-message <=> root.add-account-error;

        is-busy <=> root.add-account-is-busy;



        close => {

            root.add-account-modal-open = false;

        }

        select-provider(provider) => {

            if (provider == "microsoft") {

                root.add-account-modal-mode = "microsoft";

                root.start-microsoft-auth();

            } else if (provider == "elyby") {

                root.add-account-modal-mode = "elyby";

            } else if (provider == "offline") {

                root.add-account-modal-mode = "offline";

            }

        }

        open-url(url) => {

            root.open-url(url);

        }

        copy-code(code) => {

            root.copy-clipboard(code);

        }

        login-elyby(u, p) => {

            root.login-elyby(u, p);

        }

        create-offline(u) => {

            root.create-account(u);

        }

    }

    // --- Onboarding Setup Wizard (Sharp 0px Modal Overlay) ---
    if root.onboarding-wizard-open: OnboardingWizard {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        is-open <=> root.onboarding-wizard-open;
        current-step <=> root.onboarding-wizard-step;
        total-system-ram-mb: root.total-system-ram-mb;

        // Account State Two-Way Bindings
        has-account: root.accounts.length > 0;
        username <=> root.username;
        account-type <=> root.account-type;
        ms-user-code <=> root.ms-user-code;
        ms-verification-uri <=> root.ms-verification-uri;
        ms-status <=> root.ms-status;
        elyby-username <=> root.elyby-username;
        elyby-password <=> root.elyby-password;
        offline-username <=> root.offline-username;
        error-message <=> root.add-account-error;
        is-busy <=> root.add-account-is-busy;
        username-validation-error <=> root.username-validation-error;
        post-launch-action <=> root.post-launch-action;
        minimize-to-tray <=> root.minimize-to-tray;
        smooth-animations <=> root.smooth-animations;
        enable-walking-mobs <=> root.enable-walking-mobs;

        check-username(name) => {
            root.check-username(name);
        }

        minimize-window => {
            root.minimize-window();
        }

        maximize-window => {
            root.maximize-window();
        }

        close => {
            root.close-window();
        }

        start-microsoft-auth => {
            root.start-microsoft-auth();
        }

        open-url(url) => {
            root.open-url(url);
        }

        copy-code(code) => {
            root.copy-clipboard(code);
        }

        login-elyby(u, p) => {
            root.login-elyby(u, p);
        }

        create-offline(u) => {
            root.create-account(u);
        }

        open-account-modal => {
            root.add-account-modal-open = true;
        }

        preview-theme(theme-name) => {
            root.select-theme(theme-name);
        }

        preview-accent(hex) => {
            root.apply-custom-hex(hex);
        }

        complete(username, s-ldr, s-ver, ram-mb, post-launch, tray-on-close, theme-name, accent-hex, rpc-on, streamer-on) => {
            root.onboarding-wizard-open = false;
            root.complete-onboarding-full(username, s-ldr, s-ver, ram-mb, post-launch, tray-on-close, theme-name, accent-hex, rpc-on, streamer-on);
        }
    }



    // --- Floating Active Game Sessions Widget (bottom-right anchored, emerges out of bottom bar) ---

    property <bool> show-active-sessions: root.active-sessions.length > 0;

    property <length> sessions-target-y: root.height - active-sessions-widget.height - (root.current-tab == "Play" ? 92px : 16px);



    sessions-viewport := Rectangle {

        x: 0px;

        y: 0px;

        width: root.width;

        height: root.height - (root.current-tab == "Play" ? 80px : 0px);

        clip: true;

        background: transparent;



        active-sessions-widget := ActiveSessionsPanel {

            x: max(250px, root.width - self.width - 20px);

            y: root.show-active-sessions ? root.sessions-target-y : (root.height - (root.current-tab == "Play" ? 80px : 0px));

            opacity: root.show-active-sessions ? 1.0 : 0.0;

            sessions <=> root.active-sessions;

            animations-enabled: root.smooth-animations;



            animate y { duration: root.smooth-animations ? 320ms : 0ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

            animate opacity { duration: root.smooth-animations ? 200ms : 0ms; }



            terminate-session(id) => {

                root.terminate-game-session(id);

            }

        }

    }



    // --- Full-Window Startup Splash Overlay (Pulsating Logo & Progress Indicator) ---

    StartupSplash {

        x: 0px;

        y: 0px;

        width: root.width;

        height: root.height;

        is-active <=> root.startup-splash-active;
        ready-to-dismiss: root.startup-splash-ready;

        progress: root.startup-splash-progress;

        status-text: root.startup-splash-status;

        animations-enabled: root.smooth-animations;

        loading-spinner-frame: root.loading-spinner-frame;

    }

}

