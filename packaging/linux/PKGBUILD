pkgname=new-launcher
pkgver=4.0.2
pkgrel=1
pkgdesc='Ny-Luna Core: High-performance Minecraft Java launcher with Slint UI and modular core'
arch=('x86_64')
url='https://github.com/Amne-Dev/NLC'
license=('BSD-3-Clause')
depends=(
  'fontconfig'
  'python'
  'python-requests'
  'python-pillow'
  'python-cryptography'
  'xdg-utils'
)
makedepends=(
  'cargo'
  'rust'
)
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/Amne-Dev/NLC/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

_get_srcdir() {
  if [ -d "${srcdir}/NLC-${pkgver}" ]; then
    echo "${srcdir}/NLC-${pkgver}"
  elif [ -d "${srcdir}/New-launcher-${pkgver}" ]; then
    echo "${srcdir}/New-launcher-${pkgver}"
  else
    find "${srcdir}" -maxdepth 1 -mindepth 1 -type d | head -n 1
  fi
}

build() {
  cd "$(_get_srcdir)"
  cargo build --release --manifest-path src/frontend/Cargo.toml
}

package() {
  local appdir="${pkgdir}/usr/lib/${pkgname}"

  cd "$(_get_srcdir)"

  install -d "${appdir}"
  cp -a \
    main.py \
    VERSION \
    icons \
    wallpapers \
    assets \
    logo.png \
    src \
    "${appdir}/"

  # Install compiled native Slint UI (primary: nlc, legacy alias: newlauncher)
  install -Dm755 src/frontend/target/release/nlc-ui "${pkgdir}/usr/bin/nlc"
  ln -sf nlc "${pkgdir}/usr/bin/newlauncher"

  # Install desktop entries
  install -Dm644 packaging/linux/NewLauncher.desktop \
    "${pkgdir}/usr/share/applications/nlc.desktop"
  install -Dm644 packaging/linux/NewLauncher.desktop \
    "${pkgdir}/usr/share/applications/NewLauncher.desktop"

  # Install application icons across all standard sizes
  for sz in 16x16 22x22 24x24 32x32 48x48 64x64 128x128 256x256 scalable; do
    install -Dm644 logo.png "${pkgdir}/usr/share/icons/hicolor/${sz}/apps/nlc.png"
    install -Dm644 logo.png "${pkgdir}/usr/share/icons/hicolor/${sz}/apps/newlauncher.png"
    install -Dm644 logo.png "${pkgdir}/usr/share/icons/hicolor/${sz}/apps/NewLauncher.png"
  done
  install -Dm644 logo.png "${pkgdir}/usr/share/pixmaps/nlc.png"
  install -Dm644 logo.png "${pkgdir}/usr/share/pixmaps/newlauncher.png"
  install -Dm644 logo.png "${pkgdir}/usr/share/pixmaps/NewLauncher.png"
}
