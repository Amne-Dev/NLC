pkgname=new-launcher
pkgver=4.0.0
pkgrel=1
pkgdesc='High-performance Minecraft Java launcher with Slint UI and modular core'
arch=('x86_64')
url='https://github.com/Amne-Dev/NLC'
license=('BSD-3-Clause')
depends=(
  'fontconfig'
  'python'
  'python-requests'
  'python-pillow'
  'python-cryptography'
  'xdg-utils'
)
makedepends=(
  'cargo'
  'rust'
)
source=("https://github.com/Amne-Dev/NLC/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/New-launcher-${pkgver}"
  cargo build --release --manifest-path src/frontend/Cargo.toml
}

package() {
  local appdir="${pkgdir}/usr/lib/${pkgname}"

  cd "${srcdir}/New-launcher-${pkgver}"

  install -d "${appdir}"
  cp -a \
    main.py \
    VERSION \
    icons \
    assets \
    logo.png \
    src \
    "${appdir}/"

  # Install compiled native Slint UI (primary: nlc, legacy alias: newlauncher)
  install -Dm755 src/frontend/target/release/nlc-ui "${pkgdir}/usr/bin/nlc"
  ln -sf nlc "${pkgdir}/usr/bin/newlauncher"

  # Install desktop entry
  install -Dm644 packaging/linux/NewLauncher.desktop \
    "${pkgdir}/usr/share/applications/nlc.desktop"
  sed -i \
    -e 's/^Exec=NewLauncher$/Exec=nlc/' \
    -e 's/^Icon=logo$/Icon=newlauncher/' \
    "${pkgdir}/usr/share/applications/nlc.desktop"

  # Install application icon
  install -Dm644 logo.png \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/newlauncher.png"
}
